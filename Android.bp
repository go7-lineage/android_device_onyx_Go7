soong_namespace {
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/WCNSS_qcom_cfg.ini",
}

// Overrides apps inherited through handheld_system.mk, which PRODUCT_PACKAGES can't filter out
prebuilt_etc {
    name: "go7_no_camera",
    src: "configs/no_camera",
    overrides: [
        "CameraExtensionsProxy",
        "DeviceAsWebcam",
    ],
}
