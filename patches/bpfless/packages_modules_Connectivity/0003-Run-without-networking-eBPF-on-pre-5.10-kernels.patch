+    @RequiresApi(Build.VERSION_CODES.TIRAMISU)
+    private static void useInMemoryMaps() {
+        Log.w(TAG, "Kernel older than 5.10: no networking eBPF, firewall rules are not enforced");
+        sConfigurationMap = new InMemoryBpfMap<>();
+        sUidOwnerMap = new InMemoryBpfMap<>();
+        sUidPermissionMap = new InMemoryBpfMap<>();
+        sUidPermissionChunkMap = new InMemoryBpfMap<>();
+        sCookieTagMap = new InMemoryBpfMap<>();
+        sDataSaverEnabledMap = new InMemoryBpfMap<>();
+        sIngressDiscardMap = new InMemoryBpfMap<>();
+        sLocalNetBlockedUidMap = new InMemoryBpfMap<>();
+        synchronized (sLocalNetAccessLock) {
+            sLocalNetAccessMap = new InMemoryBpfMap<>();
+            sLocalNetUidHostAllowlistMap = new InMemoryBpfMap<>();
+            sLocalNetCacheGenerationIdMap = new InMemoryBpfMap<>();
+        }
+        sUidMigrationEnabledBpfBoolean = new BpfBoolean(new InMemoryBpfMap<>());
+        sPermissionPropagationEnabledBpfBoolean = new BpfBoolean(new InMemoryBpfMap<>());
+        sLocalNetNoteOpsEnabledBpfBoolean = new BpfBoolean(new InMemoryBpfMap<>());
+        sLoopbackAccessMetricsEnabledBpfBoolean = new BpfBoolean(new InMemoryBpfMap<>());
+        sLoopbackChecksEnabledBpfBoolean = new BpfBoolean(new InMemoryBpfMap<>());
+        sLoopbackAccessMetricsEnabled = false;
+    }
+
     @RequiresApi(Build.VERSION_CODES.TIRAMISU)
     private static void initBpfMaps(final Dependencies deps) {
+        if (BpfUtils.isBpfLessKernel()) useInMemoryMaps();
         if (sConfigurationMap == null) {
             sConfigurationMap = getConfigurationMap();
         }
