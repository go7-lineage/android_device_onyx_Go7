Subject: [PATCH 1/3] bpf: Add isBpfLessKernel() and InMemoryBpfMap

---
 bpf/headers/include/bpf/KernelUtils.h         |   4 +
 .../com/android/net/module/util/BpfUtils.java |  14 +++
 .../net/module/util/InMemoryBpfMap.java       | 103 ++++++++++++++++++
 3 files changed, 121 insertions(+)
 create mode 100644 staticlibs/device/com/android/net/module/util/InMemoryBpfMap.java

diff --git a/bpf/headers/include/bpf/KernelUtils.h b/bpf/headers/include/bpf/KernelUtils.h
index 1ee34f0..566e57b 100644
--- a/bpf/headers/include/bpf/KernelUtils.h
+++ b/bpf/headers/include/bpf/KernelUtils.h
@@ -48,6 +48,10 @@ static inline unsigned __unused kernelVersion() {
     return kernelVer;
 }
 
+static inline bool __unused isBpfLessKernel() {
+    return kernelVer < KVER(5, 10, 0);
+}
+
 #ifndef __ANDROID_API__
     #error "__ANDROID_API__ is not defined"
 #endif
diff --git a/staticlibs/device/com/android/net/module/util/BpfUtils.java b/staticlibs/device/com/android/net/module/util/BpfUtils.java
index e6e2f1f..dd43f3b 100644
--- a/staticlibs/device/com/android/net/module/util/BpfUtils.java
+++ b/staticlibs/device/com/android/net/module/util/BpfUtils.java
@@ -16,11 +16,15 @@
 package com.android.net.module.util;
 
 import android.os.Build;
+import android.os.SystemProperties;
+import android.system.Os;
 
 import androidx.annotation.NonNull;
 import androidx.annotation.RequiresApi;
 
 import java.io.IOException;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
 
 /**
  * The classes and the methods for BPF utilization.
@@ -68,4 +72,14 @@ public class BpfUtils {
 
     private static native int native_getProgramIdFromCgroup(int type, String cgroupPath)
             throws IOException;
+
+    public static boolean isBpfLessKernel() {
+        String release = SystemProperties.get("ro.bpf.kver_override");
+        if (release.isEmpty()) release = Os.uname().release;
+        final Matcher m = Pattern.compile("^(\\d+)\\.(\\d+)").matcher(release);
+        if (!m.find()) return false;
+        final int major = Integer.parseInt(m.group(1));
+        final int minor = Integer.parseInt(m.group(2));
+        return major < 5 || (major == 5 && minor < 10);
+    }
 }
