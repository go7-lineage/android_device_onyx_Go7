From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Go7 port <go7-port@example.invalid>
Date: Fri, 23 Oct 2026 12:00:00 +0000
Subject: [PATCH] bpfloader: Don't panic on critical objects on pre-5.10
 kernels

---
 loader/bpfloader.rs | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/loader/bpfloader.rs b/loader/bpfloader.rs
index f23d882..9a0c892 100644
--- a/loader/bpfloader.rs
+++ b/loader/bpfloader.rs
@@ -730,9 +730,11 @@ fn load_libbpf_progs() {
 
     let file_vec = get_file_vec();
 
+    let bpf_less = kernel_version().is_ok_and(|k| k < kver(5, 10, 0));
+
     for file_desc in file_vec {
         if let Err(e) = libbpf_worker(&file_desc) {
-            if file_desc.critical {
+            if file_desc.critical && !bpf_less {
                 panic!("Error when loading {0}: {e}", file_desc.filename);
             } else {
                 error!("Error when loading {0}: {e}", file_desc.filename);
-- 
2.54.0

