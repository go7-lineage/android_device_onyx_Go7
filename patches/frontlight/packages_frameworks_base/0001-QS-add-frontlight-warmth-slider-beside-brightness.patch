From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Go7 port <go7-port@example.invalid>
Date: Mon, 26 Oct 2026 21:11:43 +0000
Subject: [PATCH] QS: add frontlight warmth slider beside brightness

The warmth level is published through persist.vendor.go7fl.ct and applied
by the frontlightd vendor daemon, which owns the LM3630A frontlight IC.
---
 packages/SystemUI/res/values/strings.xml      |   1 +
 .../brightness/ui/compose/WarmthSlider.kt     | 137 ++++++++++++++++++
 .../qs/composefragment/QSFragmentCompose.kt   |  24 +--
 3 files changed, 152 insertions(+), 10 deletions(-)
 create mode 100644 packages/SystemUI/src/com/android/systemui/brightness/ui/compose/WarmthSlider.kt

diff --git a/packages/SystemUI/res/values/strings.xml b/packages/SystemUI/res/values/strings.xml
index d025a3ff3..ed8828f7b 100644
--- a/packages/SystemUI/res/values/strings.xml
+++ b/packages/SystemUI/res/values/strings.xml
@@ -949,6 +949,7 @@
 
     <!-- Content description of the display brightness slider (not shown on the screen). [CHAR LIMIT=NONE] -->
     <string name="accessibility_brightness">Display brightness</string>
+    <string name="accessibility_warmth">Warmth</string>
 
     <!-- Content description for AV chip when camera is in use.-->
     <string name="accessibility_camera_in_use">Camera in use</string>
diff --git a/packages/SystemUI/src/com/android/systemui/brightness/ui/compose/WarmthSlider.kt b/packages/SystemUI/src/com/android/systemui/brightness/ui/compose/WarmthSlider.kt
